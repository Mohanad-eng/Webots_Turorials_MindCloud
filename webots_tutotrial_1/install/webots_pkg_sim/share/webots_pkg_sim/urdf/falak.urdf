<?xml version="1.0" encoding="utf-8"?>
<!-- falak.urdf  6-wheel skid-steer rover -->
<robot name="falak">

  <!-- Dummy root link: KDL does not support inertia on the root link.
       base_link is connected via a fixed joint with zero offset so the
       TF tree and all joint origins remain identical to the source URDF. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child  link="base_link"/>
  </joint>

  <!-- BASE LINK -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.047556 -0.00103 0.11925" rpy="0 0 0"/>
      <mass value="17.34"/>
      <inertia ixx="0.045076" ixy="-0.00042148" ixz="-0.0021921"
               iyy="0.079609" iyz="0.00018262"  izz="0.082957"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://webots_pkg_sim/meshes_1/base_link.STL"/>
      </geometry>
      <material name="gray"><color rgba="0.753 0.753 0.753 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://webots_pkg_sim/meshes_1/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- ==========================================================
       SENSOR LINKS (fixed, mass-less for visualisation)
       ========================================================== -->

  <!-- IMU -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="imu_link"/>
  </joint>

  <!-- GPS -->
  <link name="gps_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="gps_joint" type="fixed">
    <origin xyz="0 0 0.22" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="gps_link"/>
  </joint>

  <!-- OAK-D camera body -->
  <link name="oakd_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
    <visual>
      <geometry><box size="0.02 0.1 0.03"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="oakd_joint" type="fixed">
    <origin xyz="0.45 0 0.15" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="oakd_link"/>
  </joint>

  <!-- OAK-D RGB optical frame -->
  <link name="oakd_rgb_optical_link"/>
  <joint name="oakd_rgb_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="oakd_link"/>
    <child  link="oakd_rgb_optical_link"/>
  </joint>

  <!-- OAK-D Depth optical frame (aligned with RGB) -->
  <link name="oakd_depth_optical_link"/>
  <joint name="oakd_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="oakd_link"/>
    <child  link="oakd_depth_optical_link"/>
  </joint>

  <link name="right_bogie_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    </link>
  <joint name="right_bogie_joint" type="revolute">
    <origin xyz="0.21016 -0.2862 0.1" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="right_bogie_link"/>
    <axis xyz="0 1 0"/> <limit lower="-0.5" upper="0.5" effort="100" velocity="1.0"/> </joint>

  <link name="left_bogie_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="left_bogie_joint" type="revolute">
    <origin xyz="0.20872 0.2862 0.1" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="left_bogie_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" effort="100" velocity="1.0"/>
  </joint>

  <!-- ==========================================================
       WHEEL LINKS
       All wheels identical; left/right sides are mirror images.
       ========================================================== -->

  <!-- WHEEL 1 - rear-right -->
  <link name="wheel1_link">
    <inertial>
      <origin xyz="3.8918E-05 -0.077241 2.3287E-06" rpy="0 0 0"/>
      <mass value="4.0722"/>
      <inertia ixx="0.0181"   ixy="4.8056E-11" ixz="-5.4962E-09"
               iyy="0.026492" iyz="1.8857E-11"  izz="0.0181"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://webots_pkg_sim/meshes_1/wheel1_link.STL"/>
      </geometry>
      <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1141" length="0.1194"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel1_joint" type="continuous">
    <origin xyz="-0.37409 -0.2862 0.0065869" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="wheel1_link"/>
    <axis xyz="0 -1 0"/>
    <limit effort="100" velocity="10"/> 
  </joint>

 <link name="wheel2_link">
    <inertial>
      <origin xyz="3.8918E-05 -0.077241 2.3287E-06" rpy="0 0 0"/>
      <mass value="4.0722"/>
      <inertia ixx="0.0181"   ixy="4.8056E-11" ixz="-5.4962E-09"
               iyy="0.026492" iyz="1.8857E-11"  izz="0.0181"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://webots_pkg_sim/meshes_1/wheel2_link.STL"/>
      </geometry>
      <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1141" length="0.1194"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel2_joint" type="continuous">
    <origin xyz="-0.20944 0 -0.09341" rpy="0 0 0"/>
    <parent link="right_bogie_link"/>
    <child  link="wheel2_link"/>
    <axis xyz="0 -1 0"/>
    <limit effort="100" velocity="10"/> 
  </joint>

  <link name="wheel3_link">
    <inertial>
      <origin xyz="3.8918E-05 -0.077241 2.3287E-06" rpy="0 0 0"/>
      <mass value="4.0722"/>
      <inertia ixx="0.0181"   ixy="4.8056E-11" ixz="-5.4962E-09"
               iyy="0.026492" iyz="1.8857E-11"  izz="0.0181"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://webots_pkg_sim/meshes_1/wheel3_link.STL"/>
      </geometry>
      <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1141" length="0.1194"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel3_joint" type="continuous">
    <origin xyz="0.20945 0 -0.09341" rpy="0 0 0"/>
    <parent link="right_bogie_link"/>
    <child  link="wheel3_link"/>
    <axis xyz="0 -1 0"/>
    <limit effort="100" velocity="10"/> 
  </joint>

  <link name="wheel4_link">
    <inertial>
      <origin xyz="3.5919E-05 0.077241 1.5163E-05" rpy="0 0 0"/>
      <mass value="4.0722"/>
      <inertia ixx="0.0181"   ixy="-5.1435E-11" ixz="-4.0079E-09"
               iyy="0.026492" iyz="-4.3972E-12"  izz="0.0181"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://webots_pkg_sim/meshes_1/wheel4_link.STL"/>
      </geometry>
      <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1141" length="0.1194"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel4_joint" type="continuous">
    <origin xyz="0.20944 0 -0.09414" rpy="0 0 0"/>
    <parent link="left_bogie_link"/>
    <child  link="wheel4_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10"/> 
  </joint>

  <link name="wheel5_link">
    <inertial>
      <origin xyz="3.5919E-05 0.077241 1.5163E-05" rpy="0 0 0"/>
      <mass value="4.0722"/>
      <inertia ixx="0.0181"   ixy="-5.1435E-11" ixz="-4.0079E-09"
               iyy="0.026492" iyz="-4.3972E-12"  izz="0.0181"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://webots_pkg_sim/meshes_1/wheel5_link.STL"/>
      </geometry>
      <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1141" length="0.1194"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel5_joint" type="continuous">
    <origin xyz="-0.20943 0 -0.09008" rpy="0 0 0"/>
    <parent link="left_bogie_link"/>
    <child  link="wheel5_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10"/> 
  </joint>
  <!-- WHEEL 6 - rear-left -->
  <link name="wheel6_link">
    <inertial>
      <origin xyz="3.5919E-05 0.077241 1.5163E-05" rpy="0 0 0"/>
      <mass value="4.0722"/>
      <inertia ixx="0.0181"   ixy="-5.1435E-11" ixz="-4.0079E-09"
               iyy="0.026492" iyz="-4.3972E-12"  izz="0.0181"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://webots_pkg_sim/meshes_1/wheel6_link.STL"/>
      </geometry>
      <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1141" length="0.1194"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel6_joint" type="continuous">
    <origin xyz="-0.37192 0.2862 0.0035268" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="wheel6_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10"/> 
  </joint>

  <!-- webots_ros2_driver plugin tag.
       This is how WebotsController discovers which Python class to load.
       The type must be importable: <package>.<module>.<ClassName>
       File must live at: webots_pkg_sim/webots_pkg_sim/falak_driver.py -->
  <webots>
    <plugin type="webots_pkg_sim.falak_driver.FalakDriver"/>
  </webots>

</robot>